# Copy to .env.local for development. NEVER commit real values.

# Default password given to new and reset accounts (a server-side secret). 12+ characters.
# Required in production. Use a fresh random value that appears nowhere in the repo.
DEFAULT_PASSWORD=

# One-time password for the bootstrap admin ONLY (12+ chars). Required in production and must differ
# from DEFAULT_PASSWORD, which every new joiner knows. The admin must change it at first sign-in.
BOOTSTRAP_ADMIN_PASSWORD=

# Development only: create fictional sample staff. Forbidden in production.
SEED_SAMPLE_STAFF=true

# file = local JSON files (development only). Production needs the Postgres adapter (not built yet).
STORE=file
DATA_DIR=.data

# Bootstrap admin, created on first run
BOOTSTRAP_ADMIN_STAFF_ID=MS0001
BOOTSTRAP_ADMIN_EMAIL=ld.admin@meristemng.com
