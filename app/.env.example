# Copy to .env.local for development. NEVER commit real values.

# Where data is stored: postgres (shared dev and production), file (single-process local dev only),
# memory (tests). Local files cannot work on serverless hosts, so production must use postgres.
STORE=postgres

# Postgres connection string (contains the database password: keep it ONLY here and in the host's
# secret settings). TLS is verified; production refuses sslmode=disable and no-verify.
# Example shape: postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Used only when STORE=file
DATA_DIR=.data
# Production may use STORE=file only on a single long-running server, and only with this set to true.
ALLOW_FILE_STORE=false

# Default password given to new and reset accounts (a server-side secret). 12+ characters.
# Required in production. Use a fresh random value that appears nowhere in the repo.
DEFAULT_PASSWORD=

# One-time password for the bootstrap admin ONLY (12+ chars). Required in production and must differ
# from DEFAULT_PASSWORD, which every new joiner knows. The admin must change it at first sign-in.
BOOTSTRAP_ADMIN_PASSWORD=

# Development only: create fictional sample staff. Forbidden in production.
SEED_SAMPLE_STAFF=true

# Bootstrap admin, created on first run
BOOTSTRAP_ADMIN_STAFF_ID=MS0001
BOOTSTRAP_ADMIN_EMAIL=ld.admin@meristemng.com
